{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/**/*", "shared/**/*", "electron/preload/api.d.ts"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@renderer/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
