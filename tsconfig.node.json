{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.mts",
    "electron/**/*",
    "infra/**/*",
    "shared/**/*",
    "tools/**/*",
    "tests/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node", "node"],
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@shared/*": ["./shared/*"],
      "@infra/*": ["./infra/*"],
      "@tools/*": ["./tools/*"]
    }
  }
}
