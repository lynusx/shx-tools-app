{
  "name": "shx-tools",
  "version": "0.1.0",
  "description": "内部自动化工具箱",
  "main": "./out/main/index.js",
  "author": "shx",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "prestart": "install-electron",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:win": "pnpm build && electron-builder --win",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "electron-vite build && electron . --smoke"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ant-design/icons": "~6.3.4",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "antd": "^6.6.7",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
